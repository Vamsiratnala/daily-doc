DATABASE_URL="file:./dev.db"
AUTH_SECRET="dev-secret-change-me-please-32chars-min"
# Chatbot model server (model not decided yet). Leave LLM_BASE_URL or LLM_MODEL
# empty to use the built-in retrieval-only FAQ answers.
# LLM_API_STYLE: "ollama" (native /api/chat) or "openai" (llama.cpp server, vLLM, hosted APIs)
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_STYLE="ollama"
LLM_API_KEY=""
EMBED_MODEL=""
# WhatsApp Cloud API. Leave empty to log messages instead of sending.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN="dailydoc-verify"
