// SQLite for local dev. For Vercel, switch provider to "postgresql" and point
// DATABASE_URL at Neon/Supabase (see README).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String?
  role         String        @default("PATIENT") // PATIENT | DOCTOR
  createdAt    DateTime      @default(now())
  doctor       Doctor?
  appointments Appointment[] @relation("PatientAppointments")
  reviews      Review[]
}

model Doctor {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty       String
  qualifications  String
  experienceYears Int            @default(0)
  clinicName      String
  address         String
  city            String
  lat             Float
  lng             Float
  fee             Int // INR
  bio             String         @default("")
  languages       String         @default("English") // comma separated
  conditions      String         @default("") // comma separated keywords the doctor treats
  ratingAvg       Float          @default(0)
  ratingCount     Int            @default(0)
  slotMinutes     Int            @default(15)
  createdAt       DateTime       @default(now())
  availability    Availability[]
  appointments    Appointment[]
  reviews         Review[]
}

model Availability {
  id        String @id @default(cuid())
  doctorId  String
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday
  startTime String // "09:00"
  endTime   String // "13:00"
}

model Appointment {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  problem   String
  status    String   @default("BOOKED") // BOOKED | CONFIRMED | COMPLETED | CANCELLED
  createdAt DateTime @default(now())
  review    Review?

  @@index([doctorId, startsAt])
}

model Review {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId     String
  patient       User        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  rating        Int
  comment       String      @default("")
  createdAt     DateTime    @default(now())
}

model NotificationLog {
  id        String   @id @default(cuid())
  channel   String // WHATSAPP
  to        String
  body      String
  status    String // SENT | SKIPPED | FAILED
  detail    String   @default("")
  createdAt DateTime @default(now())
}
